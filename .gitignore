# ========================================
# Laya Game Project - Root .gitignore
# ========================================
#
# 说明：
# - 此文件只包含通用规则（OS、临时文件等）
# - 子项目特定规则请查看：
#   - Sever/.gitignore（服务器规则）
#   - Client/LayaProject/.gitignore（客户端规则）
#   - Doc/.gitignore（文档规则，如需要）
#
# ========================================

# ==================== OS ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ==================== 临时文件 ====================
*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup

# ==================== 日志（顶层）====================
/logs/
*.log

# ==================== IDE（通用）====================
# 注意：子项目的 IDE 配置由各自的 .gitignore 管理
# 这里只忽略顶层的 IDE 配置

# ==================== 其他 ====================
# 如有其他通用规则，在此添加
nul

# ==================== 依赖缓存 ====================
**/node_modules/

# Vendored toolchains - install via manifests, do not commit binaries
Public/Python_env/
Public/Tools/node-v*/

# Local Windows shortcut; never part of project configuration.
/Config/Laya_FrameworkJ_laya3 - 快捷方式.lnk
