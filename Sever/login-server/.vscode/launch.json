{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Debug Login Server",
      "request": "launch",
      "mainClass": "com.jojohello_laya.login.LoginServerApplication",
      "projectName": "login-server",
      "cwd": "${workspaceFolder}/../output/servers/login-server",
      "console": "integratedTerminal",
      "args": "--logging.charset.console=UTF-8 --logging.charset.file=UTF-8",
      "vmArgs": "-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8"
    },
    {
      "type": "java",
      "name": "Debug Login Server (with active profile)",
      "request": "launch",
      "mainClass": "com.jojohello_laya.login.LoginServerApplication",
      "projectName": "login-server",
      "cwd": "${workspaceFolder}/../output/servers/login-server",
      "console": "integratedTerminal",
      "args": "--spring.profiles.active=dev --logging.charset.console=UTF-8 --logging.charset.file=UTF-8",
      "vmArgs": "-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8"
    }
  ]
}
