{
  "schemaVersion": 1,
  "feature": "login",
  "targets": ["start", "login"],
  "startModule": "login",
  "definitions": {
    "LoginRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "authCode", "platform", "deviceInfo", "version"],
      "properties": {
        "type": { "type": "string", "pattern": "^(GUEST|WECHAT)$", "minLength": 5, "maxLength": 7 },
        "authCode": { "type": "string", "minLength": 1, "maxLength": 512 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
        "deviceInfo": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "developerAccount": { "type": "string", "pattern": "^[a-zA-Z0-9_!@#$%^&*]+$", "minLength": 1, "maxLength": 24 },
        "profileEncryptedData": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "profileIv": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "LoginResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success"],
      "properties": {
        "success": { "type": "boolean" },
        "errorCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "errorMessage": { "type": "string", "minLength": 1, "maxLength": 256 },
        "token": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "loginTimestamp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "javaType": "long" },
        "nickname": { "type": "string", "minLength": 1, "maxLength": 100 },
        "avatar": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "gatewayWsUrl": { "type": "string", "pattern": "^wss?://.+", "minLength": 6, "maxLength": 2048 }
      },
      "rules": [
        {
          "when": { "field": "success", "equals": true },
          "required": ["token", "userId", "loginTimestamp", "nickname", "avatar", "gatewayWsUrl"],
          "forbidden": ["errorCode", "errorMessage"]
        },
        {
          "when": { "field": "success", "equals": false },
          "required": ["errorCode", "errorMessage"],
          "forbidden": ["token", "userId", "loginTimestamp", "nickname", "avatar", "gatewayWsUrl"]
        }
      ]
    }
  },
  "fixtures": {
    "wechat-request.json": "LoginRequest",
    "developer-request.json": "LoginRequest",
    "success-response.json": "LoginResponse",
    "error-response.json": "LoginResponse"
  },
  "bindings": [],
  "httpBindings": [
    { "method": "POST", "path": "/api/login", "request": "LoginRequest", "response": "LoginResponse" }
  ]
}

